# Copy this file to .env and replace every CHANGE_ME value.
#   cp .env.example .env
# Generate strong secrets with:  openssl rand -hex 32

# --- Open Notebook ---
# Encrypts API credentials stored in the database. Must be long & random.
OPEN_NOTEBOOK_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_32

# Basic-auth login for the Open Notebook UI (used if exposed beyond localhost)
BASIC_AUTH_USERNAME=kevin
BASIC_AUTH_PASSWORD=CHANGE_ME_strong_password

# --- SurrealDB ---
SURREAL_USER=root
SURREAL_PASSWORD=CHANGE_ME_strong_db_password
